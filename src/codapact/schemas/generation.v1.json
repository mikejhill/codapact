{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodaPact generation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "openapi"
        },
        "allow_private": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "type": "boolean"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "python"
        },
        "package": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "const": "argparse"
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_directory": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "allow_private": {
              "type": "boolean"
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allow": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "deny": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "plugin": {
          "const": "operations"
        },
        "preset": {
          "enum": [
            "all",
            "read"
          ]
        },
        "include": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/selectionRule"
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/selectionRule"
          }
        }
      }
    }
  },
  "$defs": {
    "selectionRule": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$",
            "not": {
              "pattern": "[\\u0000-\\u0020\\u007f]"
            }
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$",
            "not": {
              "pattern": "[\\u0000-\\u0020\\u007f]"
            }
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/[^?\\[\\]#\\\\\\u0000-\\u0020\\u007f]*$",
            "not": {
              "pattern": "[\\u0000-\\u0020\\u007f]"
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        }
      }
    }
  }
}
