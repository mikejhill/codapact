{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodaPact CLI definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands"],
  "properties": {
    "version": {"const": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "operation"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
          "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}
        }
      }
    }
  }
}
